<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net5.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <ApplicationManifest>Resources\app.manifest</ApplicationManifest>

    <Configurations>Debug;Release</Configurations>
    <Platforms>x64;x86</Platforms>
    <RuntimeIdentifiers>win-x64;win-x86</RuntimeIdentifiers>
    <OutputPath>Build\bin\$(Platform)\$(Configuration)\</OutputPath>
    <IntermediateOutputPath>Build\obj\$(Platform)\$(Configuration)\</IntermediateOutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Platform)' == 'x64'">
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Platform)' == 'x86'">
    <PlatformTarget>x86</PlatformTarget>
    <Prefer32Bit>true</Prefer32Bit>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishDir>Build\publish\$(Platform)\</PublishDir>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release' and '$(Platform)' == 'x64'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release' and '$(Platform)' == 'x86'">
    <RuntimeIdentifier>win-x86</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <Page Remove="Sources\App\App.xaml" />
    <ApplicationDefinition Include="Sources\App\App.xaml" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="tests\**\*.cs" />
    <EmbeddedResource Remove="tests\**\*" />
    <None Remove="tests\**\*" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\FlagsPack\CountryFlags.cs"
             Link="Shared\FlagsPack\CountryFlags.cs" />
    <Compile Include="..\Shared\NeoUI\NeoThemePalette.cs"
             Link="Shared\NeoUI\NeoThemePalette.cs" />
    <Compile Include="..\Shared\NeoUI\NeoAssetPaths.cs"
             Link="Shared\NeoUI\NeoAssetPaths.cs" />
    <Compile Include="..\Shared\NeoUI\NeoAssetService.cs"
             Link="Shared\NeoUI\NeoAssetService.cs" />
    <Compile Include="..\Shared\NeoUI\NeoTrayMenuStyle.cs"
             Link="Shared\NeoUI\NeoTrayMenuStyle.cs" />
    <Compile Include="..\Shared\NeoUI\NeoTrayMenuBuilder.cs"
             Link="Shared\NeoUI\NeoTrayMenuBuilder.cs" />
    <Compile Include="..\Shared\NeoUI\NeoTrayIconInteraction.cs"
             Link="Shared\NeoUI\NeoTrayIconInteraction.cs" />
    <Compile Include="..\Shared\NeoUI\NeoContextMenu.cs"
             Link="Shared\NeoUI\NeoContextMenu.cs" />
    <Compile Include="..\Shared\NeoUI\NeoLanguageMenuBuilder.cs"
             Link="Shared\NeoUI\NeoLanguageMenuBuilder.cs" />
    <Compile Include="..\Shared\NeoUI\NeoColorMenuBuilder.cs"
             Link="Shared\NeoUI\NeoColorMenuBuilder.cs" />
    <Compile Include="..\Shared\NeoUI\NeoMessageBox.xaml.cs"
             Link="Shared\NeoUI\NeoMessageBox.xaml.cs">
      <DependentUpon>NeoMessageBox.xaml</DependentUpon>
    </Compile>
    <Page Include="..\Shared\NeoUI\NeoMessageBox.xaml"
          Link="Shared\NeoUI\NeoMessageBox.xaml" />
    <Compile Include="..\Shared\NeoUI\NeoTitleBar.xaml.cs"
             Link="Shared\NeoUI\NeoTitleBar.xaml.cs">
      <DependentUpon>NeoTitleBar.xaml</DependentUpon>
    </Compile>
    <Page Include="..\Shared\NeoUI\NeoTitleBar.xaml"
          Link="Shared\NeoUI\NeoTitleBar.xaml" />
    <Page Include="..\Shared\NeoUI\NeoMenuStyles.xaml"
          Link="Shared\NeoUI\NeoMenuStyles.xaml" />
    <Page Include="..\Shared\NeoUI\NeoWindowStyles.xaml"
          Link="Shared\NeoUI\NeoWindowStyles.xaml" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="..\Shared\FlagsPack\Assets\**\*.png">
      <Link>Shared\FlagsPack\Assets\%(Filename)%(Extension)</Link>
    </Resource>
    <Resource Include="..\Shared\NeoUI\Assets\**\*.png">
      <Link>Shared\NeoUI\Assets\%(Filename)%(Extension)</Link>
    </Resource>
  </ItemGroup>

  <ItemGroup>
    <Content Include="Resources\assets\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <Target Name="CopyApoToPublish"
          AfterTargets="Publish"
          Condition="'$(Configuration)' == 'Release'">
    <PropertyGroup>
      <ApoPublishSource>$(MSBuildProjectDirectory)\Build\bin\$(Platform)\$(Configuration)\apo\MaxLoudApo.dll</ApoPublishSource>
      <ApoPublishDirectory>$(PublishDir)apo\</ApoPublishDirectory>
    </PropertyGroup>
    <Error Condition="!Exists('$(ApoPublishSource)')"
           Text="MaxLoudApo.dll for $(Platform) is missing: $(ApoPublishSource)" />
    <MakeDir Directories="$(ApoPublishDirectory)" />
    <Copy SourceFiles="$(ApoPublishSource)"
          DestinationFolder="$(ApoPublishDirectory)" />
  </Target>

</Project>
