<Window x:Class="MaxLoud.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:neo="clr-namespace:NeoUI"
        Title="MaxLoud"
        Style="{StaticResource NeoResizableWindowStyle}"
        Width="980"
        Height="860"
        MinWidth="820"
        MinHeight="650"
        ShowInTaskbar="False"
        Background="Transparent"
        Foreground="{DynamicResource TextBrush}"
        UseLayoutRounding="True"
        Closing="Window_OnClosing"
        Closed="Window_OnClosed">

    <Window.Resources>
        <CollectionViewSource x:Key="ApoNodesView" Source="{Binding ApoNodes}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="StageTitle" />
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>

    </Window.Resources>

    <Border Background="{DynamicResource BackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <neo:NeoTitleBar x:Name="TitleBar"
                             Grid.Row="0"
                             Margin="0,0,0,10"
                             TitleText="MaxLoud"
                             SubtitleText="{DynamicResource LocSubtitle}"
                             LanguageToolTip="{DynamicResource LocTooltipLanguage}"
                             ThemeToolTip="{DynamicResource LocTooltipTheme}"
                             CloseToolTip="{DynamicResource LocHideToTray}"
                             LanguageClick="LanguageButton_OnClick"
                             ThemeClick="ThemeButton_OnClick"
                             CloseClick="CloseButton_OnClick">
                <neo:NeoTitleBar.IconContent>
                    <Viewbox Stretch="Uniform">
                        <Canvas Width="16" Height="16">
                            <Ellipse Canvas.Left="2" Canvas.Top="1"
                                     Width="12" Height="12"
                                     Stroke="{DynamicResource PrimaryBrush}"
                                     StrokeThickness="1.35" />
                            <Line X1="4.1" Y1="5.0" X2="5.0" Y2="5.6"
                                  Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="1.05" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            <Line X1="5.4" Y1="3.6" X2="6.0" Y2="4.5"
                                  Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="1.05" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            <Line X1="8" Y1="2.4" X2="8" Y2="3.5"
                                  Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="1.05" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            <Line X1="10.6" Y1="3.6" X2="10.0" Y2="4.5"
                                  Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="1.05" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            <Line X1="11.9" Y1="5.0" X2="11.0" Y2="5.6"
                                  Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="1.05" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            <Line X1="8" Y1="7" X2="10.1" Y2="3.7"
                                  Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="1.35" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            <Ellipse Canvas.Left="6.85" Canvas.Top="5.85"
                                     Width="2.3" Height="2.3"
                                     Fill="{DynamicResource PrimaryBrush}" />
                            <Line X1="6.2" Y1="13" X2="6.2" Y2="14.8"
                                  Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="1.2" StrokeStartLineCap="Round" />
                            <Line X1="9.8" Y1="13" X2="9.8" Y2="14.8"
                                  Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="1.2" StrokeStartLineCap="Round" />
                            <Line X1="6.2" Y1="13.4" X2="9.8" Y2="13.4"
                                  Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="1.05" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </Canvas>
                    </Viewbox>
                </neo:NeoTitleBar.IconContent>
            </neo:NeoTitleBar>

            <ScrollViewer Grid.Row="1"
                          Margin="14,0,14,14"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Margin="2,0,2,12"
                               Foreground="{DynamicResource MutedTextBrush}"
                               TextWrapping="Wrap"
                               Text="{DynamicResource LocIntro}" />

                    <CheckBox x:Name="RunOnStartupCheckBox"
                              Margin="2,0,2,12"
                              Content="{DynamicResource LocRunOnStartup}"
                              Checked="RunOnStartupCheckBox_OnChanged"
                              Unchecked="RunOnStartupCheckBox_OnChanged" />

                    <Border Style="{StaticResource SectionCardStyle}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="{DynamicResource LocEndpointSection}" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource FieldLabelStyle}"
                                           Text="{DynamicResource LocOutputEndpoint}" />
                                <Button x:Name="EndpointButton"
                                        Grid.Column="1"
                                        Style="{StaticResource EndpointButtonStyle}"
                                        Click="EndpointButton_OnClick">
                                    <DockPanel LastChildFill="True">
                                        <TextBlock DockPanel.Dock="Right"
                                                   Margin="8,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                   Text="▾" />
                                        <Viewbox DockPanel.Dock="Left"
                                                 Width="16"
                                                 Margin="0,0,8,0"
                                                 VerticalAlignment="Center">
                                            <Canvas Width="16" Height="16">
                                                <Path Data="M 1,6 L 5,6 L 9,2 L 9,14 L 5,10 L 1,10 Z"
                                                      Fill="{DynamicResource MutedTextBrush}" />
                                                <Path Data="M 11,5 C 13,6 13,10 11,11 M 12.5,3.5 C 16,5.5 16,10.5 12.5,12.5"
                                                      Stroke="{DynamicResource MutedTextBrush}"
                                                      StrokeThickness="1.2"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round" />
                                            </Canvas>
                                        </Viewbox>
                                        <TextBlock x:Name="EndpointButtonText"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                </Button>
                            </Grid>

                            <WrapPanel Margin="0,12,0,0">
                                <Button Margin="0,0,8,8"
                                        Style="{StaticResource ActionButtonStyle}"
                                        Content="{DynamicResource LocRefresh}"
                                        Click="RefreshEndpointsButton_OnClick" />
                                <Button Margin="0,0,8,8"
                                        Style="{StaticResource ActionButtonStyle}"
                                        Content="{DynamicResource LocWindowsSoundSettings}"
                                        Click="WindowsSoundSettingsButton_OnClick" />
                                <Button Margin="0,0,8,8"
                                        Style="{StaticResource ActionButtonStyle}"
                                        Content="{DynamicResource LocSoundControlPanel}"
                                        Click="SoundControlPanelButton_OnClick" />
                                <Button Margin="0,0,8,8"
                                        Style="{StaticResource ActionButtonStyle}"
                                        Content="{DynamicResource LocVolumeMixer}"
                                        Click="VolumeMixerButton_OnClick" />
                                <Button Margin="0,0,8,8"
                                        Style="{StaticResource ActionButtonStyle}"
                                        Content="{DynamicResource LocOpenLogs}"
                                        Click="OpenLogsButton_OnClick" />
                                <Button Margin="0,0,8,8"
                                        Style="{StaticResource ActionButtonStyle}"
                                        Content="{DynamicResource LocCopyDiagnostics}"
                                        Click="CopyDiagnosticsButton_OnClick" />
                            </WrapPanel>

                            <Border Margin="0,6,0,10"
                                    Padding="10,8"
                                    Background="{DynamicResource PrimarySoftBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                <TextBlock x:Name="IntegrationStatusTextBlock"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap" />
                            </Border>

                            <WrapPanel>
                                <Button Margin="0,0,8,8"
                                        Style="{StaticResource PrimaryActionButtonStyle}"
                                        Content="{DynamicResource LocInstallApo}"
                                        Click="InstallApoButton_OnClick" />
                                <Button Margin="0,0,8,8"
                                        Style="{StaticResource ActionButtonStyle}"
                                        Content="{DynamicResource LocDetachApo}"
                                        Click="DetachApoButton_OnClick" />
                                <Button Margin="0,0,8,8"
                                        Style="{StaticResource DangerActionButtonStyle}"
                                        Content="{DynamicResource LocRemoveApo}"
                                        Click="RemoveApoButton_OnClick" />
                                <Button Margin="0,0,8,8"
                                        Style="{StaticResource ActionButtonStyle}"
                                        Content="{DynamicResource LocRestartAudio}"
                                        Click="RestartAudioButton_OnClick" />
                            </WrapPanel>

                            <StackPanel Margin="0,8,0,0"
                                        Orientation="Horizontal">
                                <CheckBox x:Name="SystemEnhancementsCheckBox"
                                          VerticalAlignment="Center"
                                          Content="{DynamicResource LocEnableEnhancements}"
                                          Click="SystemEnhancementsCheckBox_OnClick" />
                                <TextBlock x:Name="SystemEnhancementsOperationTextBlock"
                                           Margin="12,0,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           Visibility="Collapsed" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SectionCardStyle}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="{DynamicResource LocApoChain}" />
                            <TextBlock Margin="0,0,0,10"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       TextWrapping="Wrap"
                                       Text="{DynamicResource LocApoChainDescription}" />

                            <ListView x:Name="ApoListView"
                                      Height="270"
                                      ItemsSource="{Binding Source={StaticResource ApoNodesView}}"
                                      Background="Transparent"
                                      BorderBrush="{DynamicResource BorderBrush}"
                                      BorderThickness="1"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListView.GroupStyle>
                                    <GroupStyle>
                                        <GroupStyle.ContainerStyle>
                                            <Style TargetType="GroupItem">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="GroupItem">
                                                            <StackPanel>
                                                                <Border Padding="10,7"
                                                                        Background="{DynamicResource TitleBarBackgroundBrush}"
                                                                        BorderBrush="{DynamicResource BorderBrush}"
                                                                        BorderThickness="0,0,0,1">
                                                                    <TextBlock Text="{Binding Name}"
                                                                               FontWeight="SemiBold"
                                                                               Foreground="{DynamicResource MutedTextBrush}" />
                                                                </Border>
                                                                <ItemsPresenter />
                                                            </StackPanel>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </GroupStyle.ContainerStyle>
                                    </GroupStyle>
                                </ListView.GroupStyle>
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Margin" Value="0" />
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="BorderThickness" Value="0" />
                                        <Setter Property="Focusable" Value="False" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="10,8"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="0,0,0,1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="28" />
                                                    <ColumnDefinition Width="220" />
                                                    <ColumnDefinition Width="125" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <CheckBox IsChecked="{Binding IsAttached, Mode=OneWay}"
                                                          IsEnabled="{Binding CanDetach}"
                                                          VerticalAlignment="Center"
                                                          Click="ApoNodeCheckBox_OnClick" />
                                                <TextBlock Grid.Column="1"
                                                           Margin="0,0,12,0"
                                                           Text="{Binding DisplayName}"
                                                           FontWeight="SemiBold"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="2"
                                                           Margin="0,0,12,0"
                                                           Text="{Binding StateText}"
                                                           Foreground="{DynamicResource MutedTextBrush}"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="3"
                                                           Text="{Binding Details}"
                                                           Foreground="{DynamicResource MutedTextBrush}"
                                                           FontSize="11"
                                                           VerticalAlignment="Center"
                                                           ToolTip="{Binding Details}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <TextBlock Margin="0,10,0,0"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       TextWrapping="Wrap"
                                       Text="{DynamicResource LocApoDetachHint}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SectionCardStyle}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="{DynamicResource LocDspSection}" />
                            <TextBlock Margin="0,0,0,10"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       Text="{DynamicResource LocSignalChain}" />

                            <CheckBox x:Name="MaxLoudEnabledCheckBox"
                                      Margin="0,0,0,4"
                                      FontWeight="SemiBold"
                                      Content="{DynamicResource LocDspMaster}"
                                      Checked="DspControl_OnChanged"
                                      Unchecked="DspControl_OnChanged" />
                            <TextBlock x:Name="DspMasterStatusTextBlock"
                                       Margin="26,0,0,12"
                                       FontSize="11"
                                       Foreground="{DynamicResource MutedTextBrush}" />

                            <StackPanel x:Name="DspControlsGrid">
                                <Border Margin="0,0,0,14"
                                        Padding="12"
                                        Background="{DynamicResource BackgroundBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8">
                                    <StackPanel>
                                        <TextBlock FontWeight="SemiBold" Text="{DynamicResource LocVolumeLeveling}" />
                                        <TextBlock Margin="0,3,0,10"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                   TextWrapping="Wrap"
                                                   Text="{DynamicResource LocVolumeLevelingDescription}" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="72" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="{DynamicResource LocStrength}" />
                                            <Slider x:Name="VolumeLevelingSlider"
                                                    Grid.Column="1"
                                                    Minimum="0"
                                                    Maximum="100"
                                                    TickFrequency="1"
                                                    IsSnapToTickEnabled="True"
                                                    ValueChanged="DspSlider_OnValueChanged" />
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding ElementName=VolumeLevelingSlider, Path=Value, StringFormat={}{0:0}%}"
                                                       TextAlignment="Right"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                                        Padding="12"
                                        Background="{DynamicResource BackgroundBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8">
                                    <StackPanel>
                                        <CheckBox x:Name="CompressorCheckBox"
                                                  Margin="0,0,0,10"
                                                  FontWeight="SemiBold"
                                                  Content="{DynamicResource LocCompressorInputGain}"
                                                  Checked="DspControl_OnChanged"
                                                  Unchecked="DspControl_OnChanged" />

                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="110" /><ColumnDefinition Width="*" /><ColumnDefinition Width="72" /></Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="{DynamicResource LocInputGain}" />
                                            <Slider x:Name="InputGainSlider" Grid.Column="1" Minimum="-24" Maximum="24" TickFrequency="0.5" IsSnapToTickEnabled="True" ValueChanged="DspSlider_OnValueChanged" />
                                            <TextBlock Grid.Column="2" Text="{Binding ElementName=InputGainSlider, Path=Value, StringFormat={}{0:0.0} dB}" TextAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="110" /><ColumnDefinition Width="*" /><ColumnDefinition Width="72" /></Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="{DynamicResource LocThreshold}" />
                                            <Slider x:Name="ThresholdSlider" Grid.Column="1" Minimum="-60" Maximum="0" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="DspSlider_OnValueChanged" />
                                            <TextBlock Grid.Column="2" Text="{Binding ElementName=ThresholdSlider, Path=Value, StringFormat={}{0:0.0} dB}" TextAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="110" /><ColumnDefinition Width="*" /><ColumnDefinition Width="72" /></Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="{DynamicResource LocRatio}" />
                                            <Slider x:Name="RatioSlider" Grid.Column="1" Minimum="1" Maximum="20" TickFrequency="0.5" IsSnapToTickEnabled="True" ValueChanged="DspSlider_OnValueChanged" />
                                            <TextBlock Grid.Column="2" Text="{Binding ElementName=RatioSlider, Path=Value, StringFormat={}{0:0.0}:1}" TextAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="110" /><ColumnDefinition Width="*" /><ColumnDefinition Width="72" /></Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="{DynamicResource LocAttack}" />
                                            <Slider x:Name="AttackSlider" Grid.Column="1" Minimum="1" Maximum="200" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="DspSlider_OnValueChanged" />
                                            <TextBlock Grid.Column="2" Text="{Binding ElementName=AttackSlider, Path=Value, StringFormat={}{0:0} ms}" TextAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="110" /><ColumnDefinition Width="*" /><ColumnDefinition Width="72" /></Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="{DynamicResource LocRelease}" />
                                            <Slider x:Name="ReleaseSlider" Grid.Column="1" Minimum="10" Maximum="2000" TickFrequency="10" IsSnapToTickEnabled="True" ValueChanged="DspSlider_OnValueChanged" />
                                            <TextBlock Grid.Column="2" Text="{Binding ElementName=ReleaseSlider, Path=Value, StringFormat={}{0:0} ms}" TextAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>

                                        <CheckBox x:Name="LimiterCheckBox"
                                                  Margin="0,2,0,8"
                                                  FontWeight="SemiBold"
                                                  Content="{DynamicResource LocLimiter}"
                                                  Checked="DspControl_OnChanged"
                                                  Unchecked="DspControl_OnChanged" />
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="110" /><ColumnDefinition Width="*" /><ColumnDefinition Width="72" /></Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="{DynamicResource LocCeiling}" />
                                            <Slider x:Name="LimiterSlider" Grid.Column="1" Minimum="-12" Maximum="0" TickFrequency="0.5" IsSnapToTickEnabled="True" ValueChanged="DspSlider_OnValueChanged" />
                                            <TextBlock Grid.Column="2" Text="{Binding ElementName=LimiterSlider, Path=Value, StringFormat={}{0:0.0} dBFS}" TextAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2"
                                        Padding="12"
                                        Background="{DynamicResource BackgroundBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8">
                                    <StackPanel>
                                        <CheckBox x:Name="EqualizerCheckBox"
                                                  Margin="0,0,0,10"
                                                  FontWeight="SemiBold"
                                                  Content="{DynamicResource LocEqualizer}"
                                                  Checked="DspControl_OnChanged"
                                                  Unchecked="DspControl_OnChanged" />

                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="72" /><ColumnDefinition Width="*" /><ColumnDefinition Width="72" /></Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="80 Hz" />
                                            <Slider x:Name="Eq80Slider" Grid.Column="1" Minimum="-12" Maximum="12" TickFrequency="0.5" IsSnapToTickEnabled="True" ValueChanged="DspSlider_OnValueChanged" />
                                            <TextBlock Grid.Column="2" Text="{Binding ElementName=Eq80Slider, Path=Value, StringFormat={}{0:0.0} dB}" TextAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="72" /><ColumnDefinition Width="*" /><ColumnDefinition Width="72" /></Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="250 Hz" />
                                            <Slider x:Name="Eq250Slider" Grid.Column="1" Minimum="-12" Maximum="12" TickFrequency="0.5" IsSnapToTickEnabled="True" ValueChanged="DspSlider_OnValueChanged" />
                                            <TextBlock Grid.Column="2" Text="{Binding ElementName=Eq250Slider, Path=Value, StringFormat={}{0:0.0} dB}" TextAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="72" /><ColumnDefinition Width="*" /><ColumnDefinition Width="72" /></Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="1 kHz" />
                                            <Slider x:Name="Eq1000Slider" Grid.Column="1" Minimum="-12" Maximum="12" TickFrequency="0.5" IsSnapToTickEnabled="True" ValueChanged="DspSlider_OnValueChanged" />
                                            <TextBlock Grid.Column="2" Text="{Binding ElementName=Eq1000Slider, Path=Value, StringFormat={}{0:0.0} dB}" TextAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="72" /><ColumnDefinition Width="*" /><ColumnDefinition Width="72" /></Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="3 kHz" />
                                            <Slider x:Name="Eq3000Slider" Grid.Column="1" Minimum="-12" Maximum="12" TickFrequency="0.5" IsSnapToTickEnabled="True" ValueChanged="DspSlider_OnValueChanged" />
                                            <TextBlock Grid.Column="2" Text="{Binding ElementName=Eq3000Slider, Path=Value, StringFormat={}{0:0.0} dB}" TextAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="72" /><ColumnDefinition Width="*" /><ColumnDefinition Width="72" /></Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="8 kHz" />
                                            <Slider x:Name="Eq8000Slider" Grid.Column="1" Minimum="-12" Maximum="12" TickFrequency="0.5" IsSnapToTickEnabled="True" ValueChanged="DspSlider_OnValueChanged" />
                                            <TextBlock Grid.Column="2" Text="{Binding ElementName=Eq8000Slider, Path=Value, StringFormat={}{0:0.0} dB}" TextAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SectionCardStyle}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="{DynamicResource LocStatus}" />
                            <TextBlock x:Name="StatusTextBlock"
                                       TextWrapping="Wrap"
                                       FontFamily="Consolas"
                                       FontSize="11" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
